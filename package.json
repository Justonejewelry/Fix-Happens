    "test:core": "node core/diagnosticEngine.test.js",
    "test:plugins": "node core/pluginSystem.test.js",
    "test:scan": "node core/scanRunner.test.js"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  },
  "keywords": [
    "diagnostics",
    "troubleshooting",
