{
  "name": "fix-happens",
  "version": "1.2.0",
  "description": "Shit breaks. Fix Happens. Cross-platform field diagnostic system for macOS (Electron) and Android (Flutter): structured cases, evidence, ranked hypotheses, verification checklists, offline-first field workflow, Clear Crystal Liquid Glass UI.",
  "main": "apps/macos/main.js",
  "scripts": {
    "start": "electron .",
    "macos": "electron .",
    "dev": "electron .",
