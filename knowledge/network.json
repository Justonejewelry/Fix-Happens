{
  "id": "network-basics",
  "title": "Network diagnostics",
  "version": 2,
  "category": "network",
  "tips": [
    "Confirm link status (ifconfig / media) before assuming DHCP failure.",
    "Compare ping to gateway vs a public IP to separate LAN vs WAN problems.",
    "VPN clients often steal the default route — inspect utun interfaces.",
    "Renew DHCP with `sudo ipconfig set en0 DHCP` after confirming physical link.",
    "nslookup failure with working ping to 8.8.8.8 points to DNS, not routing."
  ],
  "relatedCauses": [
    "DHCP Failure",
    "DNS Failure",
    "VPN Route Corruption",
    "Interface Down",
    "Network Preference Corruption",
    "Firewall Block"
  ],
  "keywords": [
    "wifi", "wi-fi", "no internet", "no ip", "dhcp", "dns", "vpn", "route", "en0", "gateway"
  ],
  "scenarios": [
    {
      "id": "wifi_connected_no_internet",
      "symptom": "Wi-Fi connected but no internet",
      "tests": [
        "ping 8.8.8.8",
        "route -n get default",
        "networksetup -listallhardwareports",
        "networksetup -getinfo Wi-Fi",
        "ipconfig getifaddr en0",
        "ifconfig en0 | grep \"inet \""
      ],
      "likelyCauses": [
        "DHCP Failure",
        "Network Preference Corruption",
        "VPN Route Corruption",
        "DNS Failure"
      ],
      "repairs": [
        "Renew DHCP lease",
        "Disable VPN and network extensions",
        "Reset macOS network preferences"
      ]
    }
  ]
}
